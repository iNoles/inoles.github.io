---
import Section from './Section.astro';
import Card from './Card.astro';
import { t } from '../utils/i18n.ts';

// Pull section title and array from JSON
const sectionTitle = t('educations.title');
const sections = t('educations.history') as Array<{
  name: string;
  date: string;
  description: string;
  coursework: string[];
}>;
---

<Section title={sectionTitle}>
<div class="space-y-6">
  {sections.map((education) => (
    <Card
      title={education.name}
      date={education.date}
      description={education.description}
      tags={education.coursework}
  />
  ))}
  </div>
</Section>