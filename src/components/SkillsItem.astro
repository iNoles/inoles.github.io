---
import type { SkillCategory } from '../types/skill.ts';
const { sections } = Astro.props as { sections: SkillCategory[] };
---

<div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
  {sections.map(({ title, description, skills }) => (
    <article class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm
                    dark:border-gray-700 dark:bg-gray-800">
      <h3 class="mb-1 text-lg font-semibold text-gray-900 dark:text-white">
        {title}
      </h3>

      {description && (
        <p class="mb-4 text-sm text-gray-600 dark:text-gray-300">
          {description}
        </p>
      )}

      <ul class="flex flex-wrap gap-2">
        {skills.map((skill) => (
          <li class="inline-block rounded-full bg-gray-100 px-3 py-1 text-sm
                     font-medium text-gray-800 dark:bg-gray-700 dark:text-gray-200">
            {skill}
          </li>
        ))}
      </ul>
    </article>
  ))}
</div>