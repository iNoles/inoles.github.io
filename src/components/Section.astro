---
interface Props {
  id?: string;
  title: string;
}

const { id, title } = Astro.props;
---

<section id={id} class="scroll-mt-20 py-12 md:grid md:grid-cols-[14rem_1fr] md:gap-8">
  <h2 class="mb-6 text-2xl font-bold uppercase leading-snug tracking-wide text-gray-800
             md:sticky md:top-24 md:mb-0 md:self-start dark:text-purple-300">
    {title}
  </h2>
  <div class="min-w-0">
    <slot />
  </div>
</section>