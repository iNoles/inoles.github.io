---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import About from '../components/About.astro';
import Education from '../components/Education.astro';
import Experience from '../components/Experience.astro';
import Skills from '../components/Skills.astro';
import Project from '../components/Project.astro';
import Footer from '../components/Footer.astro';
import Certification from '../components/Certification.astro';
import Website from '../components/Website.astro';
---

<Layout>
  <div class="p-8 relative">
  <Header />
  </div>
  <main class="w-full max-w-8xl px-6 sm:px-8 lg:px-12">
    <section id="about"         class="scroll-mt-20"><About /></section>
    <section id="experience"    class="scroll-mt-20"><Experience /></section>
    <section id="live-sites"    class="scroll-mt-20"><Website /></section>
    <section id="code"          class="scroll-mt-20"><Project /></section>
    <section id="skills"        class="scroll-mt-20"><Skills /></section>
    <section id="certification" class="scroll-mt-20"><Certification /></section>
    <section id="education"     class="scroll-mt-20"><Education /></section>
  </main>
  <Footer />
</Layout>